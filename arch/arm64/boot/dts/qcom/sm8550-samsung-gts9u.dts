// SPDX-License-Identifier: BSD-3-Clause
/*
 * Samsung Galaxy Tab S9 Ultra Wi-Fi (SM-X910 / gts9uwifi) device tree.
 *
 * Authored from the live stock Samsung gts9u r03 device-tree
 * (overlay1.dts, board-id 0x10008,0x03, extracted off-device)
 * by downstream-5.15 -> mainline-7.0 binding translation, on a pristine
 * torvalds v7.0 (028ef9c96e) base, q5q (the only upstream Samsung
 * SM8550 DTS) as the structural pattern.
 *
 * Copyright (c) 2026, ubuntu-tab project.
 * Copyright (c) 2024, Alexandru Marc Serdeliuc / David Wronek (q5q pattern).
 * Copyright (c) 2022, Linaro Limited (sm8550.dtsi).
 */

/dts-v1/;

#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include "sm8550.dtsi"
#include "pm8550.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"

/*
 * Reserved-memory carveout edit-set — evidence-grounded, NOT a q5q clone.
 * 3-way bidirectional carveout check: pristine v7.0
 * sm8550.dtsi already matches the live gts9u SoC map byte-for-byte
 * except two SIZE-DIFF regions; gts9u-specific deltas only below.
 *
 *   adspslpi_mem : mainline +0x4080000 -> gts9u +0x59b4000  (SIZE-DIFF)
 *   hwfence_shbuf: mainline +0x279000  -> gts9u +0x2dd000   (SIZE-DIFF)
 *   rmtfs_mem    : DELETED  (gts9uwifi = WiFi-only; live map has no
 *                  rmtfs region — bidirectional-consistent)
 *   trust_ui_vm_*: mainline @f3600000.. -> gts9u @f3800000.. (re-addr)
 *   mpss_mem     : KEPT mainline (@8a800000 +0x10800000 == live; q5q's
 *                  @8b400000 is the OUTDATED Z-Fold5 override — NOT used)
 */
/delete-node/ &adspslpi_mem;
/delete-node/ &hwfence_shbuf;
/delete-node/ &rmtfs_mem;
/delete-node/ &trust_ui_vm_mem;
/delete-node/ &trust_ui_vm_dump;
/delete-node/ &trust_ui_vm_qrtr;
/delete-node/ &trust_ui_vm_vblk0_ring;
/delete-node/ &trust_ui_vm_vblk1_ring;
/delete-node/ &trust_ui_vm_swiotlb;

/ {
	model = "Samsung Galaxy Tab S9 Ultra";
	compatible = "samsung,gts9u", "qcom,sm8550";
	chassis-type = "tablet";

	/*
	 * Root qcom,msm-id / qcom,board-id mirror the live stock gts9u
	 * r03 DTB (overlay1.dts board-id 0x10008,0x03). Decision B.1
	 * a Samsung-format mainline DTB BY DEFINITION
	 * carries these; including them makes Step-2's first flash the
	 * implicit test of the precise-scope-banner's untested
	 * ABL-overlay-onto-Samsung-format-DTB case. Harmless to the
	 * mainline kernel (unknown root props ignored); only changes
	 * Samsung ABL LocalBoardDtMatch-on-base behaviour.
	 */
	qcom,msm-id = <0x218 0x20000 0x207 0x20000 0x207 0x10000 0x218 0x10000>;
	qcom,board-id = <0x10008 0x03>;

	aliases {
		serial0 = &uart7;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		/*
		 * gts9u panel = GTS9U_ANA38407_AMSA46AS02 (live bootargs);
		 * SM-X910 native 2960x1848. splash_region@b8000000 is the
		 * ABL cont_splash buffer (same base as q5q; live carveout
		 * map MAP). Observability, not ~6 s-critical.
		 */
		framebuffer: framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
			width = <2960>;
			height = <1848>;
			stride = <(2960 * 4)>;
			format = "a8r8g8b8";
			/*
			 * Disabled: enabling this node (so simplefb binds and drives
			 * the panel) was tested and did NOT keep the panel alive --
			 * the bootloader powers the panel down ("Splash region not
			 * found in device tree") before the kernel jump regardless of
			 * this node. Kept disabled so no simplefb probe runs during
			 * boot (baseline; isolates simplefb as a boot-time variable).
			 */
			status = "disabled";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&volume_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * panel_ldo_en — overlay1.dts fixed_regulator@0:
	 * gpio <0xffffffff 0xbb 0x00> = &tlmm 187 active-high,
	 * regulator-boot-on. Display-related; not ~6 s-critical.
	 */
	panel_ldo_en: panel-ldo-en-regulator {
		compatible = "regulator-fixed";
		regulator-name = "panel_ldo_en";
		gpio = <&tlmm 187 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* SIZE-DIFF redeclares (gts9u live values) */
		adspslpi_mem: adspslpi@9ea00000 {
			reg = <0x0 0x9ea00000 0x0 0x59b4000>;
			no-map;
		};

		hwfence_shbuf: hwfence-shbuf-region@e6440000 {
			reg = <0x0 0xe6440000 0x0 0x2dd000>;
			no-map;
		};

		/* trust_ui_vm_* redeclared at gts9u live addresses */
		trust_ui_vm_mem: trust-ui-vm-region@f3800000 {
			reg = <0x0 0xf3800000 0x0 0x40ee000>;
			no-map;
		};

		trust_ui_vm_dump: trust-ui-vm-dump-region@f78ee000 {
			reg = <0x0 0xf78ee000 0x0 0x1000>;
			no-map;
		};

		trust_ui_vm_qrtr: trust-ui-vm-qrtr-region@f78ef000 {
			reg = <0x0 0xf78ef000 0x0 0x9000>;
			no-map;
		};

		trust_ui_vm_vblk0_ring: trust-ui-vm-vblk0-ring-region@f78f8000 {
			reg = <0x0 0xf78f8000 0x0 0x4000>;
			no-map;
		};

		trust_ui_vm_vblk1_ring: trust-ui-vm-vblk1-ring-region@f78fc000 {
			reg = <0x0 0xf78fc000 0x0 0x4000>;
			no-map;
		};

		trust_ui_vm_swiotlb: trust-ui-vm-swiotlb-region@f7900000 {
			reg = <0x0 0xf7900000 0x0 0x100000>;
			no-map;
		};

		/*
		 * ADD set — gts9u XBL/TZ locks these; pristine v7.0
		 * sm8550.dtsi does NOT reserve them. THE ~6 s-killer
		 * direction (cause-4): a region XBL locked that the DT
		 * does not mark reserved -> kernel allocates -> secure
		 * violation -> ~6 s fast-fatal.
		 */
		chipinfo_mem: chipinfo-region@81cf4000 {
			reg = <0x0 0x81cf4000 0x0 0x1000>;
			no-map;
		};

		sec_xbl_ramdump_mem: sec-xbl-ramdump-region@a7d00000 {
			reg = <0x0 0xa7d00000 0x0 0x300000>;
			no-map;
		};

		kaslr_mem: kaslr-region@b01ff000 {
			reg = <0x0 0xb01ff000 0x0 0x1000>;
			no-map;
		};

		/*
		 * The bootloader keeps display hardware enabled only if this
		 * region exists; named 'splash_region' (matches the live stock
		 * resolved DT). MAP: the stock DT carves it MAP. Making it no-map
		 * (q5q-style) was tested and did NOT keep the panel alive, so it
		 * is reverted to the stock MAP carveout (baseline).
		 */
		splash_region: splash-region@b8000000 {
			reg = <0x0 0xb8000000 0x0 0x2b00000>;
		};

		llcc_lpi_mem: llcc-lpi-region@ff800000 {
			reg = <0x0 0xff800000 0x0 0x600000>;
			no-map;
		};

		/* High extended-DDR Samsung debug/boot set (live map) */
		sec_debug_region_pool: sec-debug-region-pool@880100000 {
			reg = <0x8 0x80100000 0x0 0xff000>;
		};

		sec_rst_ex_info_mem: sec-rst-ex-info-region@8801ff000 {
			reg = <0x8 0x801ff000 0x0 0x1000>;
			no-map;
		};

		sec_log_buf_region: sec-log-buf-region@880200000 {
			reg = <0x8 0x80200000 0x0 0x200000>;
		};

		sec_debug_bl_mem: sec-debug-bl-region@880400000 {
			reg = <0x8 0x80400000 0x0 0x500000>;
			no-map;
		};

		sec_pmsg_region: sec-pmsg-region@880900000 {
			reg = <0x8 0x80900000 0x0 0x200000>;
		};

		google_debug_kinfo_mem: google-debug-kinfo-region@880b00000 {
			reg = <0x8 0x80b00000 0x0 0x1000>;
			no-map;
		};

		hdm_mem: hdm-region@880b01000 {
			reg = <0x8 0x80b01000 0x0 0x1000>;
			no-map;
		};

		/*
		 * ramoops console capture: carveout-free gap (hdm-region end
		 * 0x8_80b02000 .. rdx-bootdev 0x8_80c00000), inside the
		 * ABL-declared high-DDR bank (0x8_80000000 + 0x37800000). Sizes
		 * match the downstream reader's pstore-ram zone layout so the
		 * same region is read back after a warm reboot.
		 */
		ramoops@880b10000 {
			compatible = "ramoops";
			reg = <0x8 0x80b10000 0x0 0xc0000>;
			no-map;
			console-size = <0x40000>;
			record-size = <0x20000>;
			ftrace-size = <0x20000>;
			pmsg-size = <0x0>;
			ecc-size = <0x10>;
			max-reason = <0x05>;
		};

		sec_qcom_rdx_bootdev_region: sec-qcom-rdx-bootdev-region@880c00000 {
			reg = <0x8 0x80c00000 0x0 0xad00000>;
		};
	};
};

/*
 * RPMh regulators — pm8550 family (b/c/d/e/f/g/m/n). gts9u uses the
 * same PMIC family as q5q (overlay1 confirms pm8550/pm8550vs/pmk8550);
 * the RPMh rail topology is PMIC-family-determined. q5q is the proven
 * Samsung-SM8550 instance — first-cut pattern (per-rail
 * microvolt refinement vs overlay1 is a banked follow-up, NOT
 * ~6 s-critical: the death is pre-userspace).
 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		vreg_l1b_1p8: ldo1 {
			regulator-name = "vreg_l1b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2b_3p0: ldo2 {
			regulator-name = "vreg_l2b_3p0";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5b_3p1: ldo5 {
			regulator-name = "vreg_l5b_3p1";
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			/* PTN3222 eUSB2 repeater vdd3v3: kept on with no driver
			 * consumer (the repeater is brought up in hardware --
			 * see the USB section). */
			regulator-always-on;
		};

		vreg_l6b_1p8: ldo6 {
			regulator-name = "vreg_l6b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7b_1p8: ldo7 {
			regulator-name = "vreg_l7b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l8b_1p8: ldo8 {
			regulator-name = "vreg_l8b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l9b_2p9: ldo9 {
			regulator-name = "vreg_l9b_2p9";
			regulator-min-microvolt = <2960000>;
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l11b_1p2: ldo11 {
			regulator-name = "vreg_l11b_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/*
		 * Candidate panel VDDIO (1.8V) / VCI (3.0V) rails. The panel
		 * node is wired to panel_ldo_en (the only rail the downstream
		 * device tree software-controls for the panel); these two are
		 * kept always-on as a DEFENSIVE GUESS for the panel's I/O /
		 * analog rails, pending schematic confirmation. Drop the
		 * always-on flags one at a time after first light to identify
		 * which (if any) is actually load-bearing.
		 */
		vreg_l12b_1p8: ldo12 {
			regulator-name = "vreg_l12b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l13b_3p0: ldo13 {
			regulator-name = "vreg_l13b_3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l14b_3p2: ldo14 {
			regulator-name = "vreg_l14b_3p2";
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l15b_1p8: ldo15 {
			regulator-name = "vreg_l15b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
		};

		vreg_l16b_2p8: ldo16 {
			regulator-name = "vreg_l16b_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "c";

		vreg_l3c_0p91: ldo3 {
			regulator-name = "vreg_l3c_0p9";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-2 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "d";

		vreg_l1d_0p88: ldo1 {
			regulator-name = "vreg_l1d_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-3 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "e";

		vreg_s4e_0p9: smps4 {
			regulator-name = "vreg_s4e_0p9";
			regulator-min-microvolt = <904000>;
			regulator-max-microvolt = <984000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s5e_1p1: smps5 {
			regulator-name = "vreg_s5e_1p1";
			regulator-min-microvolt = <1080000>;
			regulator-max-microvolt = <1120000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1e_0p88: ldo1 {
			regulator-name = "vreg_l1e_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2e_0p9: ldo2 {
			regulator-name = "vreg_l2e_0p9";
			regulator-min-microvolt = <904000>;
			regulator-max-microvolt = <970000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3e_1p2: ldo3 {
			regulator-name = "vreg_l3e_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-4 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "f";

		vreg_s4f_0p5: smps4 {
			regulator-name = "vreg_s4f_0p5";
			regulator-min-microvolt = <500000>;
			regulator-max-microvolt = <700000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1f_0p9: ldo1 {
			regulator-name = "vreg_l1f_0p9";
			regulator-min-microvolt = <912000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2f_0p88: ldo2 {
			regulator-name = "vreg_l2f_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3f_0p91: ldo3 {
			regulator-name = "vreg_l3f_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "g";

		vreg_s1g_1p2: smps1 {
			regulator-name = "vreg_s1g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1300000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s2g_0p8: smps2 {
			regulator-name = "vreg_s2g_0p8";
			regulator-min-microvolt = <800000>;
			regulator-max-microvolt = <1000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s3g_0p7: smps3 {
			regulator-name = "vreg_s3g_0p7";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1004000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s4g_1p3: smps4 {
			regulator-name = "vreg_s4g_1p3";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1352000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s5g_0p8: smps5 {
			regulator-name = "vreg_s5g_0p8";
			regulator-min-microvolt = <500000>;
			regulator-max-microvolt = <1004000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s6g_1p8: smps6 {
			regulator-name = "vreg_s6g_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1g_1p2: ldo1 {
			regulator-name = "vreg_l1g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2g_1p2: ldo2 {
			regulator-name = "vreg_l2g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3g_1p2: ldo3 {
			regulator-name = "vreg_l3g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-6 {
		compatible = "qcom,pm8010-rpmh-regulators";
		qcom,pmic-id = "m";

		vreg_l1m_1p056: ldo1 {
			regulator-name = "vreg_l1m_1p056";
			regulator-min-microvolt = <1056000>;
			regulator-max-microvolt = <1056000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2m_1p056: ldo2 {
			regulator-name = "vreg_l2m_1p056";
			regulator-min-microvolt = <1056000>;
			regulator-max-microvolt = <1056000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3m_2p8: ldo3 {
			regulator-name = "vreg_l3m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l4m_2p8: ldo4 {
			regulator-name = "vreg_l4m_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5m_1p8: ldo5 {
			regulator-name = "vreg_l5m_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6m_1p8: ldo6 {
			regulator-name = "vreg_l6m_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7m_2p9: ldo7 {
			regulator-name = "vreg_l7m_2p9";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2904000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-7 {
		compatible = "qcom,pm8010-rpmh-regulators";
		qcom,pmic-id = "n";

		vreg_l1n_1p1: ldo1 {
			regulator-name = "vreg_l1n_1p1";
			regulator-min-microvolt = <1104000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2n_1p1: ldo2 {
			regulator-name = "vreg_l2n_1p1";
			regulator-min-microvolt = <1104000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3n_2p8: ldo3 {
			regulator-name = "vreg_l3n_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l4n_2p8: ldo4 {
			regulator-name = "vreg_l4n_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3300000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l5n_1p8: ldo5 {
			regulator-name = "vreg_l5n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l6n_3p3: ldo6 {
			regulator-name = "vreg_l6n_3p3";
			regulator-min-microvolt = <3200000>;
			regulator-max-microvolt = <3200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7n_2p96: ldo7 {
			regulator-name = "vreg_l7n_2p96";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * Display clock controller. The DP/qmpphy parent clocks it lists resolve as
 * harmless lazy orphans on this USB2-only board (the DP RCGs are never
 * enabled); the dispcc probe configures only the two display PLLs + the XO,
 * so enabling it without usb_dp_qmpphy is safe.
 */
&dispcc {
	status = "okay";
};

/*
 * Native MIPI-DSI display bring-up. The DPU (mdss_mdp) auto-enables with its
 * &mdss parent; mdss_dp0 stays disabled (no DisplayPort on this USB2-only
 * board). The panel is a direct command-mode AMOLED (Anapass ANA38407 DDIC,
 * Samsung AMSA46AS02 module) on DSI0 lane 0-3. Until its driver
 * (panel-samsung-ana38407-amsa46as02) is loaded, the DSI component defers
 * cleanly on the unbound panel device; the driver then completes the pipeline.
 */
&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3e_1p2>;
	status = "okay";

	panel@0 {
		compatible = "samsung,ana38407-amsa46as02";
		reg = <0>;

		/*
		 * Single GPIO-gated panel-power rail (panel_ldo_en, &tlmm 187,
		 * boot-on): it enables the discrete panel-power IC that produces
		 * the panel's VCI/VDDIO/VSP/VSN. This is the only software-
		 * controlled supply the downstream device tree declares for the
		 * panel. (vreg_l12b_1p8 / vreg_l13b_3p0 are kept always-on below
		 * as a defensive guess for the panel's I/O / analog rails,
		 * pending schematic confirmation.)
		 */
		power-supply = <&panel_ldo_en>;

		reset-gpios = <&tlmm 125 GPIO_ACTIVE_LOW>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1e_0p88>;
	status = "okay";
};

&pm8550_gpios {
	volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

&pm8550vs_c {
	status = "okay";
};

&pm8550vs_d {
	status = "okay";
};

&pm8550vs_e {
	status = "okay";
};

&pm8550vs_g {
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&qupv3_id_0 {
	status = "okay";
};

/*
 * GPI DMA engine for the QUPv3 wrapper-1 buses. i2c4 (below) declares
 * dmas = <&gpi_dma1 ...> in sm8550.dtsi; mainline geni-i2c requests that tx
 * DMA channel at probe and sits in -EPROBE_DEFER forever ("Failed to get tx
 * DMA ch") if the controller is disabled. i2c4 is the first wrap-1 bus we
 * enable on this device, so gpi_dma1 must be turned on for the touchscreen
 * bus to register at all.
 */
&gpi_dma1 {
	status = "okay";
};

/*
 * Goodix gt9916 (Berlin-D) capacitive touchscreen on i2c4 (i2c@a90000),
 * i2c address 0x5d. The bus is confirmed by the stock dtbo's
 * qts,trusted-touch-io-bases = <0xa90000>; the chip identity, GPIOs and
 * rails are this device's own stock values (native goodix-berlin@5d,
 * fragment@19) and agree with the sm8550-qrd reference (gpio25 IRQ /
 * gpio24 reset / avdd = L14B). Mainline goodix_berlin_i2c binds
 * "goodix,gt9916"; firmware is factory-flashed in-IC (no request_firmware).
 * vddio (downstream iovdd = L12B) is omitted to match qrd — that rail is
 * already kept always-on for the panel, so the driver's dummy regulator
 * suffices.
 */
&i2c4 {
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt9916";
		reg = <0x5d>;

		interrupt-parent = <&tlmm>;
		interrupts = <25 IRQ_TYPE_LEVEL_LOW>;

		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_l14b_3p2>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq>, <&ts_reset>;
	};
};

/* gts9u firmware-protected GPIOs = {36,37,38,39} (
 * 2-source-verified: live qcom,gpios-reserved == overlay1).  THE
 * prime ~6 s killer (research cause-1).  Shares q5q's <36 4>
 * Samsung-SM8550-common block; does NOT reserve q5q's Z-Fold5
 * <50 2>. */
&tlmm {
	gpio-reserved-ranges = <36 4>;

	/*
	 * Goodix gt9916 touchscreen IRQ (gpio25) + reset (gpio24). GPIO
	 * numbers + rails extracted from this device's own stock dtbo
	 * (native goodix-berlin@5d, fragment@19) and cross-confirmed against
	 * the sm8550-qrd reference board's gt9916 node. Both clear of the
	 * reserved <36 4> block above.
	 */
	ts_irq: ts-irq-state {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_reset: ts-reset-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

/* UFS = the rootfs path; q5q-proven supply mapping (SoC+PMIC-level). */
&ufs_mem_hc {
	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1g_1p2>;
	vccq-max-microamp = <1200000>;
	vdd-hba-supply = <&vreg_l3g_1p2>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1d_0p88>;
	vdda-pll-supply = <&vreg_l3e_1p2>;
	status = "okay";
};

/*
 * USB device-mode gadget: dwc3 peripheral over eUSB2. USB2/high-speed only --
 * no qmpphy/SuperSpeed.
 *
 * The NXP PTN3222 eUSB2 repeater conditions the 1.2V eUSB2 signal up to 3.3V
 * USB2 for the connector, so it is electrically required. It sits on SE6 i2c
 * (@898000) -- but that SE is firmware-provisioned as UART on this device, and
 * mainline geni-i2c refuses to re-provision a non-blank SE ("Invalid proto 2"),
 * so the i2c control path is unavailable. The mainline ptn3222 driver issues
 * NO i2c transactions -- it only enables vdd3v3/vdd1v8 and deasserts the reset
 * GPIO -- so the repeater is brought up purely in hardware here: its supplies
 * are kept always-on (see vreg_l5b_3p1 below; vreg_l15b_1p8 is already
 * always-on) and its active-low RESETN (pm8550vs_d gpio4) is held deasserted
 * (driven high) by a gpio-hog. The eUSB2 phy then runs with no repeater
 * sub-phy (phys=<&ptn3222> dropped; the snps-eusb2 driver treats the repeater
 * as optional and no-ops phy_init on a NULL repeater).
 */
&pm8550vs_d_gpios {
	ptn3222_reset_deassert: ptn3222-reset-hog {
		gpio-hog;
		gpios = <4 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "ptn3222-resetn-deassert";
	};
};

&usb_1 {
	status = "okay";
	dr_mode = "peripheral";
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";

	/*
	 * USB2/high-speed only -- no SuperSpeed QMP PHY, so nothing drives the
	 * controller's PIPE clock. Without this, the DWC32 core soft reset
	 * (DCTL.CSFTRST) never completes -- it blocks until all clock domains
	 * synchronize, and the unfed PIPE domain never does -- so the controller
	 * probe fails with -ETIMEDOUT. This makes the qcom glue feed the UTMI
	 * clock into the PIPE domain instead, satisfying the reset.
	 */
	qcom,select-utmi-as-pipe-clk;
};

&usb_1_hsphy {
	vdd-supply = <&vreg_l1e_0p88>;
	vdda12-supply = <&vreg_l3e_1p2>;
	status = "okay";
};

&sleep_clk {
	clock-frequency = <32764>;
};

&xo_board {
	clock-frequency = <76800000>;
};

/*
 * Adreno 740 GPU. The SoC dtsi ships gpu@3d00000 status="disabled"; enable it
 * here. The GMU (gmu@3d6a000) and adreno_smmu (iommu@3da0000) carry no status
 * property, so they cascade to "okay" from the GPU node. SQE (a740_sqe.fw) and
 * GMU (gmu_gen70200.bin) firmware are auto-derived from the chip-id by the
 * driver and need no firmware-name. The zap shader is a PAS-signed image whose
 * trust chain is rooted in this device's QFPROM fuses, so the generic
 * linux-firmware zap is rejected by TrustZone; point firmware-name at the
 * device-extracted, Samsung-signed blob at a device-specific path so a stock
 * linux-firmware-qcom install cannot shadow it at the shared qcom/sm8550 path.
 */
&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/sm8550/samsung/gts9u/a740_zap.mbn";
};
