@@ -334,6 +334,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-hdk.dt
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-qrd.dtb
