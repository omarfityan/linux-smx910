#!/bin/busybox sh
#
# init -- first-userspace bring-up of a USB device-mode gadget on the mainline
# kernel (SM-X910). Serves TWO host-visible channels over one USB gadget:
#   (1) a busybox shell on the CDC-ACM serial (ttyGS0)  -- the proven fallback;
#   (2) adbd over a FunctionFS function (ffs.adb)       -- the richer channel
#       (adb shell / push / pull / multiple sessions), unauthenticated.
# Both functions share one configuration (composite), so the host sees the
# serial AND adb at once.
#
# Every stage writes a "<1>INIT_..." marker to /dev/kmsg (KERN_ALERT, so it
# rides into any panic/recovery crash-dump). A recovery watchdog (below) is
# armed early but bounces to recovery (TWRP) only if the success flag /serving
# is never created -- so a genuine wedge auto-recovers while a healthy serve
# stays up indefinitely.
#
# rdinit=/init ; BINFMT_SCRIPT runs this via /bin/busybox. Applets are invoked
# explicitly as `/bin/busybox <applet>`; an applet symlink farm is also
# installed into /bin so the served shells can use bare applet names.

BB=/bin/busybox
mark() { $BB echo "<1>INIT_$1" > /dev/kmsg 2>/dev/null; }

mark START

# --- pseudo-filesystems (devtmpfs gives us /dev/ttyGS0, /dev/sda10, etc.) ---
$BB mount -t proc     proc     /proc            2>/dev/null ; mark PROC
$BB mount -t sysfs    sysfs    /sys             2>/dev/null ; mark SYS
$BB mount -t devtmpfs devtmpfs /dev             2>/dev/null ; mark DEVTMPFS
$BB mount -t configfs configfs /sys/kernel/config 2>/dev/null ; mark CONFIGFS
# devpts: adbd's interactive `adb shell` allocates a PTY (openpty -> /dev/ptmx
# master + /dev/pts/N slave); without devpts mounted the shell service closes
# the connection. ptmxmode makes the slave usable by the (uid 2000) adb shell.
$BB mkdir -p /dev/pts 2>/dev/null
$BB mount -t devpts devpts /dev/pts -o ptmxmode=0666 2>/dev/null ; mark DEVPTS

# --- applet symlink farm: makes bare `ls`/`cat`/... work in the served shells
#     (both the ACM shell and any adb shell that inherits PATH=/bin). Idempotent
#     and non-fatal. ---
$BB --install -s /bin 2>/dev/null ; mark APPLET_FARM

# --- recovery watchdog: armed EARLY (covers a hang anywhere in bring-up:
#     UDC-wait, functionfs mount, adbd spawn, ep poll), but the BCB bounce is
#     GATED on the success flag /serving. /serving is created only after the
#     gadget is bound and the serve loop is about to run, so a healthy serve is
#     never bounced; only a true wedge (no /serving within 150 s) recovers. ---
(
	$BB sleep 150
	[ -f /serving ] && exit 0
	mark WATCHDOG_BOUNCE
	$BB dd if=/dev/zero of=/dev/sda10 bs=1 count=32 conv=notrunc 2>/dev/null
	$BB printf 'boot-recovery' | $BB dd of=/dev/sda10 bs=1 conv=notrunc 2>/dev/null
	$BB sync
	mark WATCHDOG_REBOOT
	$BB reboot -f
) &
mark WATCHDOG_ARMED_FLAG_GATED

# --- wait out the asynchronous dwc3 UDC probe (like the UFS probe race) ---
i=0
while [ -z "$($BB ls /sys/class/udc 2>/dev/null)" ]; do
	i=$((i + 1))
	[ "$i" -ge 75 ] && break
	$BB sleep 0.2
done
UDC="$($BB ls /sys/class/udc 2>/dev/null | $BB head -1)"
$BB echo "<1>INIT_UDC=[$UDC]" > /dev/kmsg

# --- probe-state instrumentation: rides the recovery crash-dump as <1> kmsg
#     records if the watchdog bounces. ---
$BB mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null ; mark DEBUGFS
$BB echo "<1>INIT_I2CDEV=[$($BB ls /sys/bus/i2c/devices/ 2>/dev/null)]" > /dev/kmsg
$BB echo "<1>INIT_PHYS=[$($BB ls /sys/class/phy/ 2>/dev/null)]" > /dev/kmsg
mark DEFER_BEGIN
$BB cat /sys/kernel/debug/devices_deferred 2>/dev/null | while IFS= read -r dl; do
	$BB echo "<1>INIT_DEFER:$dl" > /dev/kmsg
done
mark DEFER_END

# --- build the configfs gadget skeleton (functions + one config), but do NOT
#     link functions or write UDC yet (bind only after the ffs function is
#     ready, so a half-configured ffs.adb can't block the whole gadget). ---
G=/sys/kernel/config/usb_gadget/g1
$BB mkdir -p "$G/strings/0x409" "$G/functions/acm.usb0" "$G/configs/c.1/strings/0x409"
mark GADGET_DIRS
$BB echo 0x18d1            > "$G/idVendor"                         2>/dev/null
$BB echo 0x4ee7            > "$G/idProduct"                        2>/dev/null
$BB echo "ubuntu-tab"      > "$G/strings/0x409/manufacturer"       2>/dev/null
$BB echo "mainline-gadget" > "$G/strings/0x409/product"            2>/dev/null
$BB echo "0001"            > "$G/strings/0x409/serialnumber"       2>/dev/null
$BB echo "acm+adb"         > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null

# --- ffs.adb function: the mkdir is what lazily registers the "functionfs"
#     filesystem (the kernel registers it on the first ffs.* function created
#     in configfs), so it MUST precede the functionfs mount. The mount source
#     name "adb" must match the ffs.<name> instance. Mount it owned by uid/gid
#     2000 so ep0 is openable whether adbd runs as root (insecure mode, the
#     expected case) or drops to shell. ---
$BB mkdir "$G/functions/ffs.adb" 2>/dev/null ; mark FFS_FUNC_CREATED
$BB mkdir -p /dev/usb-ffs/adb
$BB mount -t functionfs adb /dev/usb-ffs/adb -o uid=2000,gid=2000 2>/dev/kmsg ; mark FFS_MOUNTED

# --- start the SELinux-free Linux adbd (Debian android-tools-adbd 5.1.1). It
#     opens /dev/usb-ffs/adb/ep0 and writes the FFS descriptors; the kernel then
#     creates ep1/ep2. Runs unauthenticated as root (ro.secure unset => insecure
#     mode), spawns /bin/sh. No SELinux/property-service/uid-drop coupling (the
#     reason it replaced the Android-12 adbd). LD_LIBRARY_PATH points the glibc
#     linker at the bundled closure under /lib; PATH lets the adb shell find the
#     applet farm. ---
LD_LIBRARY_PATH=/lib PATH=/bin:/sbin HOME=/ \
	/sbin/adbd </dev/null >/adbd.log 2>&1 &
mark ADBD_STARTED

# --- readiness gate (the no-property-service equivalent of sys.usb.ffs.ready):
#     ep1 AND ep2 appear only once adbd has written valid descriptors. ---
adb_ready=0
j=0
while [ "$j" -lt 50 ]; do
	if [ -e /dev/usb-ffs/adb/ep1 ] && [ -e /dev/usb-ffs/adb/ep2 ]; then
		adb_ready=1 ; break
	fi
	j=$((j + 1))
	$BB sleep 0.2
done

# --- link functions into the single config, then bind. acm is always linked
#     (the fallback shell); ffs.adb is linked only if adbd readied it. The bind
#     is self-healing: if the composite (acm+adb) bind fails (e.g. the ffs
#     function is momentarily inactive), drop adb and bind acm-only so the
#     serial shell always comes up. ---
$BB ln -s "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
if [ "$adb_ready" = 1 ]; then
	$BB ln -s "$G/functions/ffs.adb" "$G/configs/c.1/" 2>/dev/null
	if $BB echo "$UDC" > "$G/UDC" 2>/dev/kmsg; then
		mark ADB_LINKED_COMPOSITE
	else
		$BB rm -f "$G/configs/c.1/ffs.adb"
		$BB echo "$UDC" > "$G/UDC" 2>/dev/kmsg
		mark ADB_BIND_FAILED_ACM_ONLY
	fi
else
	$BB echo "$UDC" > "$G/UDC" 2>/dev/kmsg
	mark ADB_TIMEOUT_ACM_ONLY
fi
mark UDC_WRITTEN
$BB echo "<1>INIT_GADGET_STATE=[$($BB cat "$G/state" 2>/dev/null)]" > /dev/kmsg

# --- success: disarm the watchdog bounce and serve. ---
$BB touch /serving
mark SERVING_FLAG_SET

# ===========================================================================
# Path B handoff: switch_root into a real systemd root on userdata (Btrfs), if
# armed. Reached only AFTER the gadget+adb+serial lifeline is up and /serving is
# set, so the busybox fallback below is always guaranteed. A ONE-SHOT marker
# file on the target root gates the handoff:
#   present -> consume it (a failed systemd boot then reboots back to THIS
#              busybox shell), move the live pseudo-fs (incl the bound gadget at
#              /sys/kernel/config), and exec switch_root into /sbin/init (systemd);
#   absent / no root / switch_root returns -> fall through to the serve loop.
# devtmpfs already created every partition node, so blkid finds the labelled root
# (no minor-chasing). Re-arm after a fallback from the serve shell:
#   D=$(blkid -t LABEL=ubunturoot -o device); mount -t btrfs $D /mnt; \
#   touch /mnt/boot-systemd-once; sync; umount /mnt; reboot -f
# ===========================================================================
mark PATHB_BEGIN
PB_NEWROOT=/newroot
PB_LABEL=ubunturoot
PB_MARKER=boot-systemd-once
$BB mkdir -p "$PB_NEWROOT"
# Wait out a slow cold-boot UFS enumeration before giving up on the labelled
# root. A COLD boot out of Download mode (e.g. the first boot after a Thor
# flash) cold-inits the UFS; if blkid runs before the userdata partition node
# has settled it returns empty -> NO_ROOTFS -> a spurious busybox drop that a
# later (warm) reboot "fixes" purely because the UFS is then enumerated. Poll
# up to ~15 s (mirrors the UDC wait above); /serving is already set so the
# recovery watchdog is disarmed and this wait cannot trip a recovery bounce.
PB_ROOTDEV=""
k=0
while [ -z "$PB_ROOTDEV" ]; do
	PB_ROOTDEV="$($BB blkid -t LABEL=$PB_LABEL -o device 2>/dev/null | $BB head -1)"
	[ -z "$PB_ROOTDEV" ] && PB_ROOTDEV="$($BB findfs LABEL=$PB_LABEL 2>/dev/null)"
	[ -n "$PB_ROOTDEV" ] && break
	k=$((k + 1))
	[ "$k" -ge 75 ] && break
	$BB sleep 0.2
done
$BB echo "<1>INIT_PATHB_ROOTDEV=[$PB_ROOTDEV] waited=${k}x0.2s" > /dev/kmsg
if [ -n "$PB_ROOTDEV" ] && $BB mount -t btrfs -o ro "$PB_ROOTDEV" "$PB_NEWROOT" 2>/dev/kmsg; then
	# DEV-MODE BYPASS: in dr_mode=host there is no ttyGS0 serve-loop shell to
	# re-arm the one-shot $PB_MARKER, so the marker gate only traps us in the
	# passive serve loop (a single hung boot consumes the marker and the next
	# cold boot has no way back). Hand off to systemd whenever the root carries
	# /sbin/init. Restore the marker gate once a USB gadget lifeline returns.
	if [ -e "$PB_NEWROOT/sbin/init" ]; then
		mark PATHB_MARKER_BYPASS
		$BB mount -o remount,rw "$PB_NEWROOT" 2>/dev/kmsg
		$BB rm -f "$PB_NEWROOT/$PB_MARKER" ; $BB sync
		# hand the live pseudo-fs to systemd (keeps the bound USB gadget alive)
		$BB mount --move /dev  "$PB_NEWROOT/dev"  2>/dev/kmsg
		$BB mount --move /proc "$PB_NEWROOT/proc" 2>/dev/kmsg
		$BB mount --move /sys  "$PB_NEWROOT/sys"  2>/dev/kmsg
		mark PATHB_SWITCH_ROOT
		exec $BB switch_root "$PB_NEWROOT" /sbin/init
		mark PATHB_SWITCH_ROOT_FAILED   # only if exec failed
	else
		mark PATHB_NO_MARKER
		$BB umount "$PB_NEWROOT" 2>/dev/null
	fi
else
	mark PATHB_NO_ROOTFS
fi
# ===========================================================================

# --- serve an interactive shell on the gadget serial; respawn forever ---
# Give the shell a controlling tty + sane line discipline: stty sane (icrnl so
# a host CR ends a line), clocal (ignore carrier), -hupcl (no DTR churn between
# respawns); then open ttyGS0 read-write INSIDE the post-setsid child so the
# ctty-less child acquires it as its controlling terminal on the open itself,
# and cttyhack makes that explicit (TIOCSCTTY) before exec. busybox's
# documented "interactive shell from a boot script" idiom.
SHELL_CTTY_SERVE='exec /bin/busybox cttyhack /bin/busybox sh <>/dev/ttyGS0 >&0 2>&1'
mark SHELL_CTTY_SERVE_READY
while true; do
	if [ -e /dev/ttyGS0 ]; then
		$BB stty -F /dev/ttyGS0 sane clocal -hupcl 115200 2>/dev/null
		$BB setsid $BB sh -c "$SHELL_CTTY_SERVE"
	fi
	$BB sleep 1
done
